# ==============================================================================
# SnapBooth AI Backend Environment Configuration
# ==============================================================================

PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://photobooth-v2-ten.vercel.app

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage: Cloudflare R2 (Optional - defaults to Supabase storage fallback if unset)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=photobooth-media
R2_PUBLIC_URL=https://media.yourdomain.com

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
FRONTEND_URL=http://localhost:3000

# Email & Sharing Services
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=photos@yourdomain.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# AI Engines (Tier 1 & Tier 2)
CF_ACCOUNT_ID=...
CF_AI_TOKEN=...
HUGGINGFACE_API_TOKEN=...
